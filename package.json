{
  "name": "rueditasdebiciJs",
  "displayName": "Protocolo Rueditas de Bici JS",
  "description": "Herramienta educativa diseñada para enseñar las bases de la programación. Transforma tu código JavaScript en diagramas de flujo animados con visor de memoria RAM y CPU en tiempo real. (Solo compatible con código síncrono usando prompt-sync como método de entrada).",
  "version": "0.3.0",
  "publisher": "ever23",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ever23/RueditasDeBici.js"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "RueditasDeBici.js.showFlowchart",
        "title": "RueditasDeBici: Mostrar Diagrama de Flujo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rueditasDeBici",
          "title": "Rueditas de Bici",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "rueditasDeBici": [
        {
          "type": "webview",
          "id": "RueditasDeBici.js.flowchartView",
          "name": "Diagrama de Flujo"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "RueditasDeBici.js.diagramEditor",
        "displayName": "Editor de Diagramas RueditasDeBici",
        "selector": [
          {
            "filenamePattern": "*.rdb"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build:webview": "cd webview-ui && npm run build",
    "build": "concurrently \"npm run build:extension\" \"npm run build:webview\"",
    "test": "jest",
    "watch:extension": "npm run build:extension -- --watch",
    "watch:webview": "cd webview-ui && npm run dev",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "package": "npx vsce package --out releases/"
  }
}
